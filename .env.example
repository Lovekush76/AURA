# Production Configuration Baseline
AURA_ENV=production
AURA_API_HOST=127.0.0.1
AURA_API_PORT=8000
AURA_API_KEY=aura_sec_default_change_me

# Model Engine & FlashAttention Q4 KV-Cache Optimization (32K-128K Local Context)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q4_0

# NVIDIA NIM Hybrid Cloud Engine (Nemotron 3 Ultra - 550B / 1,000,000 Token Context)
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=

# Host IPC Sockets
SANDBOX_SOCKET_PATH=/run/aura/sandbox.sock
VOICE_IPC_WS_URL=ws://127.0.0.1:8000/api/v1/voice/ipc

# Audio Biometrics & Storage
AUDIO_PROFILES_DIR=data/audio_profiles
CHROMA_PERSIST_DIR=data/chromadb
AUDIT_LOG_PATH=data/logs/audit.log

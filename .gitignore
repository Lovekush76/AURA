# ==============================================================================
# Aura Assistant - Sovereign Workspace Git Ignore Rules
# ==============================================================================

# Python Virtual Environments & Packages
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
*$py.class

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml

# Node.js & Frontend Bundles
frontend/node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local Sovereign Databases & Storage (Zero-Leakage Guarantee)
*.db
*.db-*
*.sqlite
*.sqlite3
data/db/*.db
!data/db/.gitkeep

# Environment & Secrets (Air-Gap Protection)
.env
.env.local
.env.*.local
*.key
*.pem
*.cert

# Test Scripts & Automated Verification Artifacts
frontend/test_ui_e2e.js
frontend/test_responsive_voice_e2e.js
frontend/capture_views.js
*.png
*.log

# Editor & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
